# Copia a .env y rellena. No subas .env a git.
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=cambia-esta-contraseña
MYSQL_ROOT_PASSWORD=cambia-esta-contraseña-root
GHOST_URL=https://tuhoy.com
GHOST_ADMIN_API_KEY=

# Correo de Ghost (Brevo SMTP). Usuario y clave en Brevo → SMTP & API → SMTP.
MAIL_FROM=TuHoy <info@tuhoy.com>
MAIL_OPTIONS_HOST=smtp-relay.brevo.com
MAIL_OPTIONS_PORT=587
MAIL_OPTIONS_SECURE=false
MAIL_OPTIONS_AUTH_USER=
MAIL_OPTIONS_AUTH_PASS=

# Redacción con IA (scripts/writer.py). Sin clave, la edición diaria usa el resumen extractivo.
# LLM_PROVIDER: openai | anthropic | gemini | openrouter
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Opcionales: modelo concreto, URL compatible con OpenAI y verificación de hechos (1/0)
LLM_MODEL=
LLM_BASE_URL=
LLM_FACTCHECK=1

# Posts diarios en X (scripts/x_posts.py)
# X_MODE: email (manda los posts por correo, gratis) | api (los publica solo; requiere créditos en X)
X_MODE=email
X_EMAIL_TO=raulrgleon@gmail.com
# X_LINKS: all | none | N (cupo diario: los N primeros posts del día llevan enlace). Con enlace X cobra más por post.
X_LINKS=2
# Máximo de posts por tanda (una tanda tras cada edición) y minutos entre posts.
X_POSTS=14
X_SPACING=60
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Artículos por correo: estas variables van en /etc/tuhoy-mail.env (root:root, 600).
# systemd las entrega al servicio; no guardar contraseñas en el repositorio.
# TUHOY_IMAP_USER=cuenta@gmail.com
# TUHOY_IMAP_PASSWORD=contraseña-de-aplicación-google
# TUHOY_MAIL_STATE=/home/raul/tuhoy/data/mail-private
# Respuestas editoriales: utiliza BREVO_SMTP_LOGIN y BREVO_SMTP_KEY de .env.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
