{{!< default}}

<article class="th-article">
    {{#page}}
    <div class="th-wrap">
        {{> "breadcrumbs" current=title}}
    </div>
    <header class="th-article-head">
        <div class="th-article-head-inner">
            <p class="th-kicker">El diario</p>
            <h1 class="th-hed-article">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="th-dek th-dek-article">{{custom_excerpt}}</p>
            {{/if}}
        </div>
    </header>
    {{#if feature_image}}
    <figure class="th-article-figure">
        <img
            src="{{img_url feature_image size="l"}}"
            srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 960w, {{img_url feature_image size="xl"}} 1400w"
            sizes="(max-width: 1100px) 100vw, 1100px"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        >
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}
    <div class="th-article-layout th-page-layout">
        <div class="th-article-body">
            {{content}}
        </div>
    </div>
    {{/page}}
</article>
