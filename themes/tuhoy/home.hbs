{{!< default}}

{{#get "posts" limit="5" include="tags" order="published_at desc"}}
<section class="th-breaking" id="ultima-hora" aria-label="Últimas noticias">
    <div class="th-wrap th-breaking-inner">
        <p class="th-breaking-label">Hoy en TuHoy</p>
        <ul class="th-breaking-list">
            {{#foreach posts}}
            <li>
                <time datetime="{{date format="YYYY-MM-DDTHH:mmZ"}}">{{date format="DD MMM"}}</time>
                <a href="{{url}}">{{title}}</a>
            </li>
            {{/foreach}}
        </ul>
    </div>
</section>
{{/get}}

<div class="th-wrap">
    {{!-- Solo noticias de las últimas 48 h; destacar prioriza sin renovar su fecha. --}}
    {{#get "posts" filter="published_at:>=now-2d+tag:-hash-boletin" limit="4" order="featured desc,published_at desc" include="tags,authors"}}
        {{#if posts}}
            {{> "opening"}}
        {{else}}
            {{!-- Sin actividad reciente: mostrar lo último con aviso explícito. --}}
            {{#get "posts" filter="tag:-hash-boletin" limit="4" order="published_at desc" include="tags,authors"}}
                {{#if posts}}
                    <p class="th-meta" role="status">No hay noticias nuevas en las últimas 48 horas. Estas son las últimas publicaciones.</p>
                    {{> "opening"}}
                {{/if}}
            {{/get}}
        {{/if}}
    {{/get}}

    {{> "reader-invitation"}}

    {{!-- Solo contenido real etiquetado por la redacción; sin guías ficticias. --}}
    {{#get "posts" filter="tag:vida-practica+tag:-hash-boletin" limit="3" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-practical">
        {{> "section-head" name="Vivir en Estados Unidos" section_url="/tag/vida-practica/"}}
        <div class="th-cols-3">
            {{#foreach posts}}{{> "story-col"}}{{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:politica+tag:-inmigracion+featured:false" limit="5" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-lead-side">
        {{> "section-head" name="Política" section_url="/tag/politica/"}}
        <div class="th-split">
            <div>
                {{#foreach posts limit="1"}}
                    {{> "story-lead"}}
                {{/foreach}}
            </div>
            <div class="th-stack">
                {{#foreach posts from="2" to="5"}}
                    {{> "story-text"}}
                {{/foreach}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:mundo+tag:-politica+tag:-economia+featured:false" limit="3" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-columns">
        {{> "section-head" name="Mundo" section_url="/tag/mundo/"}}
        <div class="th-cols-3">
            {{#foreach posts}}
                {{> "story-col"}}
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:inmigracion+featured:false" limit="5" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-feature-list" id="inmigracion">
        {{> "section-head" name="Inmigración y Latinos" section_url="/tag/inmigracion/"}}
        <div class="th-split">
            <div>
                {{#foreach posts limit="1"}}
                    {{> "story-lead"}}
                {{/foreach}}
            </div>
            <div class="th-stack">
                {{#foreach posts from="2" to="5"}}
                    {{> "story-text" show_excerpt=true}}
                {{/foreach}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:economia+featured:false" limit="5" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-feature-list">
        {{> "section-head" name="Economía" section_url="/tag/economia/"}}
        <div class="th-split th-split-reverse">
            <div class="th-stack">
                {{#foreach posts from="2" to="5"}}
                    {{> "story-text" show_excerpt=true}}
                {{/foreach}}
            </div>
            <div>
                {{#foreach posts limit="1"}}
                    {{> "story-col"}}
                {{/foreach}}
            </div>
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:comunidad+tag:-hash-boletin" limit="3" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-community">
        {{> "section-head" name="Historias de nuestra comunidad" section_url="/tag/comunidad/"}}
        <div class="th-cols-3">{{#foreach posts}}{{> "story-col"}}{{/foreach}}</div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:tangle+featured:false" limit="3" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-opinion">
        {{> "section-head" name="Análisis"}}
        <div class="th-cols-3">
            {{#foreach posts}}
                {{> "story-opinion"}}
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:tecnologia" limit="4" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-compact">
        {{> "section-head" name="Tecnología" section_url="/tag/tecnologia/"}}
        <div class="th-compact">
            {{#foreach posts}}
                {{> "story-text" show_excerpt=true}}
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:salud" limit="2" include="tags,authors"}}
    {{#if posts}}
    <section class="th-section th-pattern-feature-list">
        {{> "section-head" name="Salud" section_url="/tag/salud/"}}
        <div class="th-cols-2">
            {{#foreach posts}}
                {{> "story-col"}}
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}

</div>
