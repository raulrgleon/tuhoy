{{!< default}}

<article class="th-article">
    {{#post}}
    <div class="th-wrap">
        {{#if primary_tag}}
            {{> "breadcrumbs" section=primary_tag.name section_url=primary_tag.url current=title}}
        {{else}}
            {{> "breadcrumbs" current=title}}
        {{/if}}
    </div>
    <header class="th-article-head">
        <div class="th-article-head-inner">
            {{> "story-kicker"}}
            <h1 class="th-hed-article">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="th-dek th-dek-article">{{custom_excerpt}}</p>
            {{/if}}
            <div class="th-article-byline">
                {{#foreach authors}}
                    <a class="th-author-name" href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}
                {{/foreach}}
                <time datetime="{{date format="YYYY-MM-DDTHH:mmZ"}}">{{date format="D MMM YYYY, HH:mm"}}</time>
                <span>{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
            </div>
            <div class="th-share" aria-label="Compartir esta noticia">
                <a class="th-share-button th-share-wa" href="https://wa.me/?text={{encode title}}%20{{encode url absolute="true"}}" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp">
                    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.6-.3Z"/></svg>
                    WhatsApp
                </a>
                <a class="th-share-button" href="https://www.facebook.com/sharer/sharer.php?u={{encode url absolute="true"}}" target="_blank" rel="noopener" aria-label="Compartir en Facebook">
                    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4a20 20 0 0 0-2.2-.1c-2.2 0-3.7 1.3-3.7 3.8v2.4H8.1v3h2.5V21h2.9Z"/></svg>
                    Facebook
                </a>
                <a class="th-share-button" href="https://x.com/intent/post?text={{encode title}}&url={{encode url absolute="true"}}&via=TuHoy_" target="_blank" rel="noopener" aria-label="Compartir en X">
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.4 5.8L17.8 3Zm-1 16.2h1.7L7.3 4.7H5.5l11.3 14.5Z"/></svg>
                    X
                </a>
                <button class="th-share-button" type="button" data-share-native data-share-title="{{title}}" aria-label="Compartir noticia">
                    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M10 13.5V3m0 0L6.5 6.5M10 3l3.5 3.5M4 10.5V16h12v-5.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    Compartir
                </button>
                <button class="th-share-button" type="button" data-copy-link aria-label="Copiar enlace de la noticia">
                    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M7.5 12.5 12.5 7.5M6.2 14.8l-1 1a2.8 2.8 0 0 1-4-4l3-3a2.8 2.8 0 0 1 4 0M13.8 5.2l1-1a2.8 2.8 0 1 1 4 4l-3 3a2.8 2.8 0 0 1-4 0" transform="translate(-.5 0)" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    Copiar enlace
                </button>
                <span class="th-share-status" data-share-status aria-live="polite"></span>
            </div>
        </div>
    </header>

    {{#if feature_image}}
    <figure class="th-article-figure">
        <img
            src="{{img_url feature_image size="xl"}}"
            srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 960w, {{img_url feature_image size="xl"}} 1400w"
            sizes="(max-width: 1100px) 100vw, 1100px"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            fetchpriority="high"
            decoding="async"
        >
        {{#if feature_image_caption}}
            <figcaption>{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    <div class="th-article-layout">
        <div class="th-article-body" data-article-body>
            {{content}}
            <aside class="th-tip" aria-label="Envíanos un aviso">
                <p class="th-tip-title">¿Sabes algo que debamos contar?</p>
                <p>Mándanos tu aviso, foto o denuncia por WhatsApp. Si nos pides reserva, protegemos tu identidad.</p>
                <a class="th-btn th-tip-btn" href="https://wa.me/14028240388?text={{encode "Hola TuHoy, quiero enviarles un aviso:"}}" target="_blank" rel="noopener">WhatsApp (402) 824-0388</a>
            </aside>
            {{#unless @member}}
            <aside class="th-subscribe" aria-label="Suscríbete al boletín">
                <p class="th-subscribe-title">Lo que importa hoy, en tu correo</p>
                <p>Cada mañana, las noticias principales en español. Gratis y sin spam: te das de baja con un clic.</p>
                <form class="th-subscribe-form" data-members-form="signup">
                    <input data-members-email type="email" required placeholder="Tu correo electrónico" aria-label="Tu correo electrónico">
                    <button class="th-btn" type="submit">Suscribirme</button>
                    <p class="th-subscribe-msg th-subscribe-ok">¡Listo! Revisa tu correo para confirmar la suscripción.</p>
                    <p class="th-subscribe-msg th-subscribe-err">No se pudo completar. Revisa el correo e inténtalo otra vez.</p>
                </form>
            </aside>
            {{/unless}}
            <p class="th-follow">Síguenos en <a href="https://www.facebook.com/tuhoynoticias" target="_blank" rel="noopener">Facebook</a>, <a href="https://www.instagram.com/tuhoynoticias/" target="_blank" rel="noopener">Instagram</a> y <a href="https://x.com/TuHoy_" target="_blank" rel="noopener">X</a>.</p>
        </div>
        <aside class="th-rail" aria-label="Más noticias">
            <p class="th-section-name">Últimas</p>
            {{#get "posts" limit="5" include="tags" filter="id:-{{id}}"}}
                {{#foreach posts}}
                    {{> "story-text"}}
                {{/foreach}}
            {{/get}}
        </aside>
    </div>

    {{#if primary_tag}}
    {{#get "posts" limit="4" include="tags,authors" filter="tag:{{primary_tag.slug}}+id:-{{id}}"}}
    {{#if posts}}
    <section class="th-related">
        {{> "section-head" name="Más noticias"}}
        <div class="th-cols-4">
            {{#foreach posts}}
                {{> "story-col"}}
            {{/foreach}}
        </div>
    </section>
    {{/if}}
    {{/get}}
    {{/if}}
    {{/post}}
</article>
