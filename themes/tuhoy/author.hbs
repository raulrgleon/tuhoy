{{!< default}}
{{#contentFor "author_name"}}{{#author}}{{name}}{{/author}}{{/contentFor}}

<div class="th-wrap th-page">
    {{#author}}
    {{> "breadcrumbs" section="Redacción" current=name}}
    <header class="th-page-head th-author-head">
        {{#if profile_image}}
            <img class="th-author-photo" src="{{img_url profile_image size="s"}}" alt="{{name}}">
        {{else}}
            <div class="th-author-photo th-author-fallback" aria-hidden="true">TH</div>
        {{/if}}
        <div>
            <p class="th-kicker">Redacción</p>
            <h1 class="th-hed-l">{{name}}</h1>
            {{#if bio}}<p class="th-dek">{{bio}}</p>{{/if}}
            {{#if location}}<p class="th-meta">{{location}}</p>{{/if}}
        </div>
    </header>
    {{/author}}
    <div class="th-archive-heading">
        <h2>Últimos artículos</h2>
    </div>
    <div class="th-feed">
        {{#foreach posts}}
            {{> "story-col"}}
        {{else}}
            <p>No hay artículos de este autor.</p>
        {{/foreach}}
    </div>
    {{pagination}}
</div>
