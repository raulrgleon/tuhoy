{{!-- Complementa {{ghost_head}}: locale, robots e indexación. --}}
<meta property="og:locale" content="es_US">
<meta name="google-site-verification" content="Xeigui0WNCdoLEptlysCYu4UbFjMYB4PTSqVese1i84">
<meta name="theme-color" content="#141414">
<meta name="twitter:site" content="@TuHoy_">
{{!-- Van después de ghost_head para que el navegador prefiera el favicon del tema al de Ajustes. --}}
<link rel="icon" href="{{asset "images/favicon-32.png"}}" sizes="32x32" type="image/png">
<link rel="icon" href="{{asset "images/favicon-192.png"}}" sizes="192x192" type="image/png">
<link rel="icon" href="{{asset "images/favicon.svg"}}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{asset "images/apple-touch-icon.png"}}">
{{#is "error"}}
    <meta name="robots" content="noindex, follow">
{{else}}
    {{#is "post"}}
        {{#post}}
            {{#has tag="#resumen-automatico"}}
                <meta name="robots" content="noindex, follow">
            {{else}}
                <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
            {{/has}}
        {{/post}}
    {{else}}
        {{#is "tag"}}
            {{#match tag.slug "=" "tangle"}}
                <meta name="robots" content="noindex, follow">
            {{else match tag.slug "=" "associated-press"}}
                <meta name="robots" content="noindex, follow">
            {{else match tag.slug "=" "ground-news"}}
                <meta name="robots" content="noindex, follow">
            {{else}}
                <meta name="robots" content="index, follow, max-image-preview:large">
            {{/match}}
        {{else}}
            <meta name="robots" content="index, follow, max-image-preview:large">
        {{/is}}
    {{/is}}
{{/is}}
