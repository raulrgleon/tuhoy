<header class="th-section-head">
    <h2 class="th-section-name">
        {{#if url}}<a href="{{@site.url}}{{url}}">{{name}}</a>{{else}}{{name}}{{/if}}
    </h2>
    {{#if url}}
        <a class="th-section-more" href="{{@site.url}}{{url}}" aria-label="Ver más noticias de {{name}}">
            Más noticias
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
            </svg>
        </a>
    {{/if}}
</header>
