{{#if feature_image}}
<figure class="th-media {{#if ratio}}th-media-{{ratio}}{{else}}th-media-wide{{/if}}">
    <a href="{{url}}" tabindex="-1" aria-hidden="true">
        <img
            src="{{img_url feature_image size="l"}}"
            srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 960w, {{img_url feature_image size="xl"}} 1400w"
            sizes="{{#if sizes}}{{sizes}}{{else}}(max-width: 720px) 100vw, 66vw{{/if}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            {{#if eager}}fetchpriority="high"{{else}}loading="lazy"{{/if}}
            decoding="async"
        >
    </a>
</figure>
{{/if}}
